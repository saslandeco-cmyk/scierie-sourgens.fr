# Connection string Postgres POOLED (hostname avec "-pooler"), via Vercel
# Storage (Neon) ou neon.tech — utilisee a l'execution par l'app.
DATABASE_URL=

# Connection string Postgres DIRECTE (sans "-pooler"), meme base — utilisee
# uniquement par `prisma migrate` (les DDL passent mal par le pooler PgBouncer).
# Neon fournit les deux URLs sur la meme page ; Vercel les injecte en general
# sous des noms differents (ex. DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING)
# qu'il faut reporter manuellement ici sous ce nom.
DIRECT_URL=

# Identifiant de connexion au back-office
ADMIN_USERNAME=

# Hash bcrypt du mot de passe admin — generer avec :
# node -e "console.log(require('bcryptjs').hashSync('VOTRE_MOT_DE_PASSE', 10))"
# IMPORTANT : le hash contient des caracteres "$" (ex: $2b$10$...). Le loader
# d'env de Next.js fait de l'expansion de variables sur "$NOM" : il FAUT donc
# echapper chaque "$" en "\$" dans ce fichier, sinon le hash sera tronque
# silencieusement et la connexion admin echouera. Exemple :
# ADMIN_PASSWORD_HASH=\$2b\$10\$abcdefghijklmnopqrstuv/WxYz0123456789ABCDEFGHI
ADMIN_PASSWORD_HASH=

# Cle de signature des sessions (32 octets aleatoires) — generer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Token du store Vercel Blob (Storage > Create > Blob)
BLOB_READ_WRITE_TOKEN=
